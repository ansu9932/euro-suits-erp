{
  "name": "euro-suits-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare npm run check && DEPLOY_TARGET=cloudflare vite build",
    "test:proxy": "node --test tests/edge-proxy.test.mjs",
    "predev": "node scripts/prepare-pdf-preview.mjs",
    "prebuild": "node scripts/prepare-pdf-preview.mjs",
    "prebuild:cloudflare": "node scripts/prepare-pdf-preview.mjs",
    "test:sample-forms": "node --experimental-strip-types --test tests/sample-form-pdf.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@lucide/svelte": "^1.46.0",
    "@sveltejs/adapter-node": "6.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "animejs": "4.5.0",
    "jsbarcode": "^3.12.1",
    "pdfjs-dist": "6.5.438",
    "pdfmake": "0.3.13",
    "qrcode": "^1.5.4",
    "svelte": "5.58.0",
    "three": "^0.186.1",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "8.0.3",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "wrangler": "^4.146.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
